<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On-device wake-word + transcription listens on the mic. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Matches Xcode's local Development signing profile. This is for the
	     free on-device alpha only; release distribution uses Developer ID. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
