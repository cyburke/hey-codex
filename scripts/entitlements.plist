<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On-device wake-word detection listens on the mic. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Deliberately NOT set: com.apple.security.get-task-allow.
	     It permits any process to attach a debugger, which is not something
	     an always-listening microphone app should hand out in a public build.
	     Add it back locally if you need to attach a debugger. -->
</dict>
</plist>
