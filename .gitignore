.DS_Store
.build/
*.xcodeproj/xcuserdata/
Models/*
# …but the hand-authored keyword file is a small tracked text artifact.
!Models/keywords.txt
# …and bpe.vocab is a small (12 KB) deterministic text derivative of the pinned
# KWS model's bpe.model, produced by scripts/make-bpe-vocab.py. Tracking it
# means a fresh clone can build without installing Python + sentencepiece.
# A parent directory excluded by Models/* still hides files inside it even
# after a "!" re-include, so the directory has to be un-ignored and then
# everything else in it re-excluded, leaving only bpe.vocab tracked.
!Models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/
Models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/*
!Models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/bpe.vocab
Sources/CSherpaOnnx/sherpa-onnx.xcframework/
Tests/HeyClaudeKitTests/Fixtures/*.wav
*.onnx

# Fonts: General Sans (ITF Free Font License) is NOT redistributable — keep the
# .otf files local, never commit them. The app falls back to the system font.
*.otf

# Secrets / signing material — must never be committed.
*.p12
*.mobileprovision
.env
.env.*

# Maintainer-only release tooling — release.sh stays private (it carries the
# personal signing/notarization identity). entitlements.plist IS tracked: it's
# just app entitlements (mic + Apple-events) and the release CI needs it.
scripts/release.sh

# Landing pages live in their own repos — ignored here.
site/
web/
.playwright-mcp/

# Private working docs + project notes — kept local-only, never published.
# (Planning, design notes, AI-assistant guidance live in the working tree for
# reference/dev, but the public repo ships none of it.)
docs/
CLAUDE.md

# Built app bundles and release archives are regenerated locally; never commit them.
dist/
HeyCodex.app/
HeyCodex.dmg
HeyCodex-notarize.zip

# Local agent / harness state — never publish.
.superpowers/
.claude/
HeyClaude.app/

# Internal review notes: local paths, signing identity, build hashes.
EXTERNAL_REVIEW_BRIEF.md
